{
  "manifest_version": 3,
  "name": "LinkedIn AI Post Assistant",
  "version": "1.0.0",
  "description": "Generate AI-powered LinkedIn posts without leaving LinkedIn.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "https://www.linkedin.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "panel/utils/dom.js",
        "panel/services/api.js",
        "panel/utils/linkedinEditor.js",
        "content.js"
      ],
      "css": [],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["panel/styles/panel.css", "icons/*.png"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "LinkedIn AI Post Assistant"
  }
}
