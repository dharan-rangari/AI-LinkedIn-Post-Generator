# Groq API key used by llm_helper.py (ChatGroq)
GROQ_API_KEY=your_groq_api_key_here

# Comma separated list of origins allowed to call this API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deploy Qwen/Qwen-Image-2.1 as a Hugging Face Inference Endpoint.
# HF_IMAGE_ENDPOINT_URL must point to that deployment.
HF_TOKEN=your_huggingface_token_here
HF_IMAGE_MODEL=Qwen/Qwen-Image-2.1
HF_IMAGE_ENDPOINT_URL=https://your-endpoint.endpoints.huggingface.cloud
IMAGE_PROMPT_MODE=hybrid
# Set to true to use offline local 16:9 illustration generation
MOCK_IMAGE_GENERATION=false
